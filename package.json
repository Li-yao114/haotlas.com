{
  "name": "haotlas.com",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "node tools/dev.mjs",
    "content": "node tools/build-content.mjs",
    "new": "node tools/new-post.mjs",
    "build": "npm run content && vite build && node tools/build-editor.mjs && node tools/prerender.mjs",
    "preview": "vite preview",
    "test": "node --test tools/*.test.mjs",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "new:photo": "node tools/new-post.mjs --photography"
  },
  "dependencies": {
    "maplibre-gl": "6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "gh-pages": "6.3.0",
    "gray-matter": "4.0.3",
    "sharp": "0.35.5",
    "vite": "8.3.8"
  }
}
